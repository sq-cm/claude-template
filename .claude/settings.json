{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git remote *)",
      "Bash(git config --get *)",
      "Bash(git config --list)",
      "Bash(git fetch *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -v)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(mktemp *)",
      "Bash(cygpath *)",
      "Bash(pip3 show *)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(npm outdated *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(cargo tree)",
      "Bash(cargo tree *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(tree)",
      "Bash(tree *)",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:anthropic.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:webflow.com)",
      "WebFetch(domain:developers.webflow.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:pypi.org)",
      "Write(Inbox/**)",
      "Write(Projects/**)",
      "Write(Notes/**)",
      "Write(Resources/**)",
      "Write(Vault/**)",
      "Edit(Inbox/**)",
      "Edit(Projects/**)",
      "Edit(Notes/**)",
      "Edit(Resources/**)",
      "Edit(Vault/**)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/coverage/**)",
      "Read(./**/*.min.js)",
      "Read(./**/*.lock)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(if command -v cygpath >/dev/null 2>&1; then cygpath -u \"${CLAUDE_PROJECT_DIR:-.}\"; else echo \"${CLAUDE_PROJECT_DIR:-.}\"; fi)/.claude/hooks/read-guard.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(if command -v cygpath >/dev/null 2>&1; then cygpath -u \"${CLAUDE_PROJECT_DIR:-.}\"; else echo \"${CLAUDE_PROJECT_DIR:-.}\"; fi)/.claude/hooks/session-start-onboarding.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(if command -v cygpath >/dev/null 2>&1; then cygpath -u \"${CLAUDE_PROJECT_DIR:-.}\"; else echo \"${CLAUDE_PROJECT_DIR:-.}\"; fi)/.claude/hooks/load-context.sh\" \"Theme map loaded\" \"Vault/Memory/theme-name-map.md\""
          },
          {
            "type": "command",
            "command": "bash \"$(if command -v cygpath >/dev/null 2>&1; then cygpath -u \"${CLAUDE_PROJECT_DIR:-.}\"; else echo \"${CLAUDE_PROJECT_DIR:-.}\"; fi)/.claude/hooks/load-context.sh\" \"Memory index loaded\" \"Vault/Memory/MEMORY.md\""
          },
          {
            "type": "command",
            "command": "bash \"$(if command -v cygpath >/dev/null 2>&1; then cygpath -u \"${CLAUDE_PROJECT_DIR:-.}\"; else echo \"${CLAUDE_PROJECT_DIR:-.}\"; fi)/.claude/hooks/load-context.sh\" \"Local context loaded\" \"Vault/Memory/context.md\" \"No local context.md yet — run install or /memory-reconcile to create it from context.example.md\""
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"continue\": false, \"stopReason\": \"Worktree creation disabled — work directly in main directory\"}'"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(if command -v cygpath >/dev/null 2>&1; then cygpath -u \"${CLAUDE_PROJECT_DIR:-.}\"; else echo \"${CLAUDE_PROJECT_DIR:-.}\"; fi)/.claude/hooks/memory-pending.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(if command -v cygpath >/dev/null 2>&1; then cygpath -u \"${CLAUDE_PROJECT_DIR:-.}\"; else echo \"${CLAUDE_PROJECT_DIR:-.}\"; fi)/.claude/hooks/memory-pending.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TURNS=$(cat | jq 'try (.transcript | length) catch 0' 2>/dev/null || echo 0) && [ \"${TURNS:-0}\" -gt 5 ] && echo '📝 Meaningful session detected. Run /log-session if worth keeping.' || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: grill-me + plan mode apply per CLAUDE.md § Default Mode (one question at a time, recommend answers, explore before asking).'"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$(if command -v cygpath >/dev/null 2>&1; then cygpath -u \"$CLAUDE_PROJECT_DIR\"; else echo \"$CLAUDE_PROJECT_DIR\" | sed 's|\\\\|/|g; s|^\\([A-Za-z]\\):|/\\L\\1|'; fi)/.claude/statusline.sh\""
  },
  "tui": "fullscreen",
  "remoteControlAtStartup": true,
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      },
      "autoUpdate": false
    },
    "claude-mem": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "enabledPlugins": {
    "plannotator@plannotator": true,
    "context-mode@context-mode": true,
    "obsidian@obsidian-skills": true,
    "superpowers@claude-plugins-official": true,
    "caveman@caveman": true,
    "impeccable@impeccable": true,
    "marketing-skills@marketingskills": true,
    "document-skills@anthropic-agent-skills": true,
    "claude-mem@claude-mem": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
