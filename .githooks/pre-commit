#!/usr/bin/env bash
# pre-commit — restrict commits to teammate-editable paths
#
# Allowlist: Chats/, Notes/, Projects/ (all gitignored — typically empty in staged diff).
# Anything else means the commit is touching template state and is rejected.
# Known trade-off: tracked seed files under an allowlisted folder (Chats/README.md,
# Projects/Template/*) pass this gate, so upstream PR protection is the real guard there.
#
# Maintainer override: export CLAUDE_TEMPLATE_MAINTAINER=1

set -e

if [ "$CLAUDE_TEMPLATE_MAINTAINER" = "1" ]; then
  # Run the vault consistency validator in WARN mode (Odin correction 1+2+3).
  # Output is printed for visibility, but a non-zero exit is swallowed so the
  # hook never blocks a maintainer commit. The validator's own exit code remains
  # honest for CLI/CI use — only the hook swallows it here.
  echo "--- validate.sh (WARN mode — failures are advisory, not blocking) ---"
  bash "$(git rev-parse --show-toplevel)/Vault/Scripts/validate.sh" || true
  echo "---"
  exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMRTD)

if [ -z "$STAGED" ]; then
  exit 0
fi

VIOLATIONS=$(echo "$STAGED" | grep -vE '^(Chats/|Notes/|Projects/)' || true)

if [ -n "$VIOLATIONS" ]; then
  echo ""
  echo "❌  Commit blocked — this is a shared template vault."
  echo ""
  echo "    You're trying to commit files outside the teammate-editable zone"
  echo "    (Chats/, Notes/, Projects/). The template flows one direction:"
  echo "    upstream → your clone. Local edits to template files stay local."
  echo ""
  echo "    Files in this commit that are not allowed:"
  echo "$VIOLATIONS" | sed 's/^/      - /'
  echo ""
  echo "    To recover:"
  echo "      git reset HEAD <file>     # unstage individual files"
  echo "      git stash                 # park everything for later"
  echo ""
  echo "    If you genuinely need a template change, propose it to the"
  echo "    maintainer — do not commit it from your clone."
  echo ""
  exit 1
fi

exit 0
