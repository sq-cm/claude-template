# Secrets — never commit
.env
.env.local
.env.*.local

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Claude Code internals
.claude/cache/
.claude/logs/
.claude/settings.local.json
.claude/worktrees/

# Obsidian internals
.obsidian/workspace
.obsidian/workspace.json
