.mypy_cache/
.ruff_cache/

# Playwright MCP browser-test output
.playwright-mcp/

# Logs
*.log
npm-debug.log*
pip-log.txt

# Ref-import failure log — written by /import-ref, machine-local
Vault/Logs/ref-failures.md

# MemPalace per-project files
mempalace.yaml
entities.json
Vault/Logs/Palace/

# Per-vault append-only memory logs — diverge per machine, not part of template seed
Vault/Memory/theme-change-log.md
Vault/Memory/odin-misses.md
Vault/Memory/repo-conflicts.md
Vault/Memory/roster-drift-log.md

# Per-clone state — written by hooks, machine-local
Vault/Memory/onboarding-flags.json
Vault/Memory/onboarding-errors.md
Vault/Memory/.theme-lock
Vault/Memory/theme-name-map-*.md
Vault/Memory/Sessions/

# /update throttle state + error log — written by update.sh and the
# update-check.sh SessionStart hook, machine-local
Vault/Memory/.update-check-state
Vault/Memory/update-check-errors.md

# Per-clone local team memory — reconcile + bootstrap write target (context.example.md is the tracked seed)
Vault/Memory/context.md
Vault/Memory/reconcile-errors.md

# Per-clone session notes — local only; folder skeleton kept via .gitkeep
Vault/Memory/Notes/
!Vault/Memory/Notes/.gitkeep

# Per-clone work products — audit sweeps and strategic recommendations; not template seed
Vault/Memory/audit_*
Vault/Memory/recommendations_*

# Personal work — local only, backed by Google Drive
/Notes/
/Projects/
Vault/Archive/
Vault/Attachments/
Vault/Audits/
Vault/Bases/
Vault/Categories/
Vault/Exports/
Vault/Logs/Handoffs/
Vault/Logs/Sessions/
Vault/Plans/
Vault/Specs/

# Personal learning workspaces (teach skill) — local only, backed by Google Drive.
# README kept tracked so fresh clones get the folder + explainer.
Vault/Learning/*
!Vault/Learning/README.md

# Local Netlify folder
.netlify

# Paseo — local coding-agent orchestrator state, machine-local
paseo.json

# Unlighthouse — local site-audit scan output, machine-local
.unlighthouse/
