# Obsidian internals
.obsidian/workspace
.obsidian/workspace.json
.obsidian/workspaces.json

# Octarine
.octarine/

# Git repo clones — reference only, not committed
Resources/Git/*/

# Temporary / working files
*.tmp
*.bak
~$*
*~
*.swp
*.swo

# Editor / IDE
.idea/

# Build / runtime artefacts
node_modules/
__pycache__/
*.pyc
*.pyo
