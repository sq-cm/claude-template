{
  "mcpServers": {
    "analytics-mcp": {
      "command": "uvx",
      "args": ["--python", "3.12", "analytics-mcp"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${USERPROFILE}/.config/claude-google/adc.json",
        "GOOGLE_PROJECT_ID": "sq-claude-integrations"
      }
    },
    "gsc": {
      "command": "npx",
      "args": ["-y", "mcp-server-gsc"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${USERPROFILE}/.config/claude-google/adc.json"
      }
    }
  }
}
