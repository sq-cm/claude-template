# Environment Variables — Example
# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Unlocks: Claude API access — required for all AI team operations in this vault
# Get: https://console.anthropic.com/settings/keys
# Required
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google / Workspace ───────────────────────────────────────────────────────
# Unlocks: Google APIs (Maps, Search, Sheets, etc.) via server-side calls
# Get: https://console.cloud.google.com/apis/credentials
# Optional
GOOGLE_API_KEY=

# Unlocks: OAuth 2.0 client identity for Google Workspace MCP integrations
# Get: https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client IDs)
# Optional
GOOGLE_CLIENT_ID=

# Unlocks: OAuth 2.0 client secret paired with GOOGLE_CLIENT_ID
# Get: same credentials page as GOOGLE_CLIENT_ID
# Optional
GOOGLE_CLIENT_SECRET=

# ─── Email ────────────────────────────────────────────────────────────────────
# Unlocks: Gmail MCP integration — read/send email via OAuth
# Get: https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client IDs, Gmail scope)
# Optional
GMAIL_CLIENT_ID=

# Unlocks: OAuth 2.0 client secret paired with GMAIL_CLIENT_ID
# Get: same credentials page as GMAIL_CLIENT_ID
# Optional
GMAIL_CLIENT_SECRET=

# Unlocks: persistent Gmail access without re-authorising each session
# Get: run OAuth consent flow once; token returned by Google's auth server
# Optional
GMAIL_REFRESH_TOKEN=

# ─── MCP Servers ──────────────────────────────────────────────────────────────
# Add API keys for any MCP servers configured in .claude/
# Example:
# # Unlocks: GitHub MCP — repo read/write, PR and issue management
# # Get: https://github.com/settings/tokens
# # Optional
# GITHUB_TOKEN=
#
# # Unlocks: Slack MCP — message read/send via bot integration
# # Get: https://api.slack.com/apps (Bot Token, OAuth & Permissions)
# # Optional
# SLACK_BOT_TOKEN=
#
# # Unlocks: Notion MCP — page and database read/write
# # Get: https://www.notion.so/profile/integrations
# # Optional
# NOTION_API_KEY=

# ─── Project-specific ─────────────────────────────────────────────────────────
# Add any project or client-specific secrets below this line

# ─── Maintainer flag (shell profile only — NOT loaded from .env) ──────────────
# CLAUDE_TEMPLATE_MAINTAINER=1 — set in your shell profile (e.g. ~/.zshrc, ~/.bashrc,
# or Windows env vars) to bypass the auto-onboarding SessionStart hook and other
# onboarding flows. Referenced by install.sh, install.bat, .githooks/pre-commit,
# .githooks/pre-push, and .claude/hooks/session-start-onboarding.sh.
# Leave unset on fresh clones — those should run onboarding.
